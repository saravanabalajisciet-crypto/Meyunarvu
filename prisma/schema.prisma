// Meyunarvu — Prisma Schema
// Phase 1: publishing workflow
// Phase 2 tables (Manuscript, Chapter) are defined but have no UI yet.
// CP3: User model, Role enum, Post.authorId added.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum PostStatus {
  draft
  published
}

enum PostType {
  article
  thirukkural
  letter
  business_idea
  linkedin_post
}

// CP3: role hierarchy
enum Role {
  reader
  author
  admin
}

// CP3: notification event types
enum NotificationType {
  COMMENT_ON_POST
  REPLY_TO_COMMENT
}

// ---------------------------------------------------------------------------
// CP3: Users
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(reader)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts         Post[]
  comments      Comment[]
  favorites     Favorite[]
  notifications Notification[]
}

// ---------------------------------------------------------------------------
// CP3: Comments (threaded via parentId)
// ---------------------------------------------------------------------------

model Comment {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  parentId  String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post     Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  @@index([postId])
  @@index([userId])
  @@index([parentId])
}

// ---------------------------------------------------------------------------
// CP3: Favorites
// ---------------------------------------------------------------------------

model Favorite {
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// CP3: Notifications
// ---------------------------------------------------------------------------

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  payload   Json
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Core content tables
// ---------------------------------------------------------------------------

model Post {
  id          String     @id @default(uuid())
  title       String
  // slug is set once on creation — the API ignores slug in PATCH requests
  slug        String     @unique
  content     String?    // Markdown
  excerpt     String?    // manual or trimmed on publish
  status      PostStatus @default(draft)
  type        PostType   @default(article)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  // CP3: nullable so existing posts remain valid — set on creation going forward
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  tags             PostTag[]
  images           Image[]
  thirukkuralMeta  ThirukkuralMeta?
  letterMeta       LetterMeta?
  linkedInMeta     LinkedInMeta?
  businessIdeaMeta BusinessIdeaMeta?
  comments         Comment[]
  favorites        Favorite[]
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  posts Post[]
}

model Tag {
  id    String    @id @default(uuid())
  name  String    @unique
  slug  String    @unique
  posts PostTag[]
}

model PostTag {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model Image {
  id           String   @id @default(uuid())
  postId       String
  url          String
  storageKey   String   // provider-specific key used for deletion
  altText      String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Post-type companion tables (1:1 with Post)
// ---------------------------------------------------------------------------

model ThirukkuralMeta {
  id                 String  @id @default(uuid())
  postId             String  @unique
  tamilCouplet       String
  englishTranslation String
  tamilCommentary    String?
  englishCommentary  String?
  kuralNumber        Int?    @unique

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model LetterMeta {
  id             String    @id @default(uuid())
  postId         String    @unique
  recipient      String?
  letterDate     DateTime?
  responseStatus String?
  letterContent  String?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model LinkedInMeta {
  id           String    @id @default(uuid())
  postId       String    @unique
  linkedInUrl  String    // canonical source; displayed as backlink
  originalDate DateTime?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model BusinessIdeaMeta {
  id            String @id @default(uuid())
  postId        String @unique
  freeUseNotice String @default("These ideas are free for anyone to take and build. No attribution or credit required.")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Phase 2 — manuscripts (schema present, no UI in Phase 1)
// ---------------------------------------------------------------------------

model Manuscript {
  id             String    @id @default(uuid())
  title          String
  slug           String    @unique
  passphraseHash String
  isPublic       Boolean   @default(false)
  createdAt      DateTime  @default(now())

  chapters Chapter[]
}

model Chapter {
  id           String     @id @default(uuid())
  manuscriptId String
  title        String?
  slug         String
  content      String?    // Markdown
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())

  manuscript Manuscript @relation(fields: [manuscriptId], references: [id], onDelete: Cascade)

  @@unique([manuscriptId, slug])
}
